{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glafira.local/contracts/v1/glafira-task-agent.schema.json",
  "title": "GLAFIRA Task and Agent Contracts v1",
  "oneOf": [
    {
      "$ref": "#/$defs/TaskEnvelope"
    },
    {
      "$ref": "#/$defs/TaskResultEnvelope"
    },
    {
      "$ref": "#/$defs/TaskStatusEvent"
    },
    {
      "$ref": "#/$defs/AgentHeartbeat"
    },
    {
      "$ref": "#/$defs/AgentEnrollmentRequest"
    },
    {
      "$ref": "#/$defs/AgentEnrollmentDecision"
    },
    {
      "$ref": "#/$defs/TaskLease"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "TaskEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "taskId",
        "projectId",
        "idempotencyKey",
        "taskType",
        "payloadRef",
        "payloadSha256",
        "issuedByDeviceId",
        "requiredCapabilities",
        "dependencyTaskIds",
        "riskClass",
        "createdAt",
        "deadlineAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/Identifier"
        },
        "taskType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "payloadRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "payloadSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "issuedByDeviceId": {
          "$ref": "#/$defs/Identifier"
        },
        "targetAgentId": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "dependencyTaskIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 256
        },
        "riskClass": {
          "enum": [
            "READ_ONLY",
            "LOCAL_WRITE",
            "EXTERNAL_SIDE_EFFECT",
            "PRIVILEGED"
          ]
        },
        "approvalRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "deadlineAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "resourceBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRuntimeSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "maxMemoryMiB": {
              "type": "integer",
              "minimum": 64,
              "maximum": 65536
            },
            "maxCpuPercent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "riskClass": {
                "enum": [
                  "EXTERNAL_SIDE_EFFECT",
                  "PRIVILEGED"
                ]
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "required": [
              "approvalRef"
            ],
            "properties": {
              "approvalRef": {
                "$ref": "#/$defs/Identifier"
              }
            }
          }
        }
      ]
    },
    "TaskResultEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "taskId",
        "agentId",
        "leaseId",
        "fencingToken",
        "attempt",
        "outcome",
        "completedAt",
        "resultSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "leaseId": {
          "$ref": "#/$defs/Identifier"
        },
        "fencingToken": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "outcome": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "WAITING_FOR_OWNER",
            "OUTCOME_UNKNOWN"
          ]
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resultRef": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "resultSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z0-9_]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "requiresReconciliation": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "OUTCOME_UNKNOWN"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "requiresReconciliation": {
                "const": true
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "SUCCEEDED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "resultRef",
              "resultSha256"
            ],
            "properties": {
              "resultRef": {
                "type": "string"
              },
              "resultSha256": {
                "$ref": "#/$defs/Sha256"
              }
            }
          }
        }
      ]
    },
    "TaskStatusEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "taskId",
        "state",
        "occurredAt",
        "sequence"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "state": {
          "enum": [
            "QUEUED",
            "WAITING_FOR_DEPENDENCIES",
            "WAITING_FOR_AGENT",
            "LEASED",
            "RUNNING",
            "WAITING_FOR_OWNER",
            "RETRY_SCHEDULED",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "OUTCOME_UNKNOWN"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "reasonCode": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z0-9_]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AgentHeartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "agentId",
        "hostId",
        "status",
        "sentAt",
        "capabilities",
        "activeLeaseIds",
        "resourceUsage"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "hostId": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "enum": [
            "STARTING",
            "READY",
            "BUSY",
            "PAUSED",
            "DRAINING",
            "OFFLINE",
            "REVOKED"
          ]
        },
        "sentAt": {
          "type": "string",
          "format": "date-time"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "activeLeaseIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "resourceUsage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpuPercent",
            "memoryUsedMiB"
          ],
          "properties": {
            "cpuPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "memoryUsedMiB": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "AgentEnrollmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "enrollmentId",
        "agentId",
        "hostId",
        "displayName",
        "fingerprint",
        "requestedCapabilities",
        "requestedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "enrollmentId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "hostId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "fingerprint": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128
        },
        "requestedCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "AgentEnrollmentDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "enrollmentId",
        "agentId",
        "decision",
        "decidedByDeviceId",
        "decidedAt",
        "grantedCapabilities"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "enrollmentId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED",
            "REVOKED"
          ]
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "grantedCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "decidedByDeviceId": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "TaskLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "leaseId",
        "taskId",
        "agentId",
        "fencingToken",
        "issuedAt",
        "expiresAt",
        "heartbeatIntervalSeconds"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "leaseId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "fencingToken": {
          "type": "integer",
          "minimum": 1
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "heartbeatIntervalSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        }
      }
    }
  }
}
