{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glafira.local/contracts/v1/project-coordinator.schema.json",
  "title": "GLAFIRA Project Coordinator and Node Contracts v1",
  "oneOf": [
    {
      "$ref": "#/$defs/ProjectNodeRecord"
    },
    {
      "$ref": "#/$defs/CoordinatorLeaseRecord"
    },
    {
      "$ref": "#/$defs/CoordinatorClaimRequest"
    },
    {
      "$ref": "#/$defs/ProjectTaskClaimRecord"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Signature": {
      "type": "string",
      "minLength": 80,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "contentEncoding": "base64"
    },
    "ProjectNodeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "nodeId",
        "installationId",
        "platform",
        "nodeKind",
        "coordinatorEligible",
        "capabilities",
        "appVersion",
        "enrollmentGeneration",
        "credentialEpoch",
        "lastSeenSequence",
        "participationState",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "nodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "installationId": {
          "$ref": "#/$defs/Identifier"
        },
        "platform": {
          "enum": [
            "ANDROID",
            "WINDOWS_DESKTOP",
            "WINDOWS_AGENT",
            "IOS"
          ]
        },
        "nodeKind": {
          "enum": [
            "FULL_GLAFIRA",
            "WORKER_AGENT"
          ]
        },
        "coordinatorEligible": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9._-]*$"
          }
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "enrollmentGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "credentialEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "lastSeenSequence": {
          "type": "integer",
          "minimum": 1
        },
        "participationState": {
          "enum": [
            "ACTIVE",
            "PAUSED",
            "REVOKED"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "nodeKind": {
                "const": "WORKER_AGENT"
              }
            },
            "required": [
              "nodeKind"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "coordinatorEligible": {
                "const": false
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "participationState": {
                "const": "REVOKED"
              }
            },
            "required": [
              "participationState"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "coordinatorEligible": {
                "const": false
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "CoordinatorLeaseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "coordinatorNodeId",
        "coordinatorGeneration",
        "leaseId",
        "heartbeatSequence",
        "issuedAt",
        "expiresAt",
        "credentialEpoch",
        "state",
        "signingKeyEpoch",
        "signingPublicKeySha256",
        "signatureAlgorithm",
        "signature"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "coordinatorNodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "coordinatorGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "leaseId": {
          "$ref": "#/$defs/Identifier"
        },
        "heartbeatSequence": {
          "type": "integer",
          "minimum": 1
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "credentialEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "ACTIVE",
            "RELEASED"
          ]
        },
        "signingKeyEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "signingPublicKeySha256": {
          "$ref": "#/$defs/Sha256"
        },
        "signatureAlgorithm": {
          "const": "ECDSA_P256_SHA256"
        },
        "signature": {
          "$ref": "#/$defs/Signature"
        }
      }
    },
    "CoordinatorClaimRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "candidateNodeId",
        "expectedGeneration",
        "observedLeaseId",
        "requestId",
        "idempotencyKey",
        "issuedAt",
        "signingKeyEpoch",
        "signingPublicKeySha256",
        "signatureAlgorithm",
        "signature"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "candidateNodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "expectedGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "observedLeaseId": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestId": {
          "$ref": "#/$defs/Identifier"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/Identifier"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "signingKeyEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "signingPublicKeySha256": {
          "$ref": "#/$defs/Sha256"
        },
        "signatureAlgorithm": {
          "const": "ECDSA_P256_SHA256"
        },
        "signature": {
          "$ref": "#/$defs/Signature"
        }
      }
    },
    "ProjectTaskClaimRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "taskId",
        "assignedNodeId",
        "coordinatorGeneration",
        "taskStateVersion",
        "leaseId",
        "fencingToken",
        "idempotencyKey",
        "inputSha256",
        "claimedAt",
        "expiresAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "assignedNodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "coordinatorGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "taskStateVersion": {
          "type": "integer",
          "minimum": 0
        },
        "leaseId": {
          "$ref": "#/$defs/Identifier"
        },
        "fencingToken": {
          "type": "integer",
          "minimum": 1
        },
        "idempotencyKey": {
          "$ref": "#/$defs/Identifier"
        },
        "inputSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "claimedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
