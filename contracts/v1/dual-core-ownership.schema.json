{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glafira.local/contracts/v1/dual-core-ownership.schema.json",
  "title": "GLAFIRA Dual-Core Ownership Transfer v1",
  "oneOf": [
    {
      "$ref": "#/$defs/OwnershipTransferEnvelope"
    },
    {
      "$ref": "#/$defs/TaskOwnershipRecord"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "TaskOwnershipRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "taskId",
        "projectId",
        "ownerCoreId",
        "ownerGeneration",
        "stateVersion",
        "payloadSha256",
        "idempotencyKey"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "ownerCoreId": {
          "$ref": "#/$defs/Identifier"
        },
        "ownerGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 0
        },
        "payloadSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "OwnershipTransferEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "transferId",
        "nonce",
        "taskId",
        "projectId",
        "oldOwnerCoreId",
        "newOwnerCoreId",
        "oldOwnerGeneration",
        "newOwnerGeneration",
        "stateVersion",
        "payloadSha256",
        "idempotencyKey",
        "effectRisk",
        "approvalRef",
        "issuedAt",
        "expiresAt",
        "signingKeyEpoch",
        "signingPublicKeySha256",
        "signatureAlgorithm",
        "signatureFormat",
        "signature"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "transferId": {
          "$ref": "#/$defs/Identifier"
        },
        "nonce": {
          "$ref": "#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "oldOwnerCoreId": {
          "$ref": "#/$defs/Identifier"
        },
        "newOwnerCoreId": {
          "$ref": "#/$defs/Identifier"
        },
        "oldOwnerGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "newOwnerGeneration": {
          "type": "integer",
          "minimum": 2
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 0
        },
        "payloadSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/Identifier"
        },
        "effectRisk": {
          "enum": [
            "READ_ONLY",
            "DRAFT",
            "EXTERNAL_SIDE_EFFECT",
            "FINANCIAL",
            "DESTRUCTIVE"
          ]
        },
        "approvalRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "signingKeyEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "signingPublicKeySha256": {
          "$ref": "#/$defs/Sha256"
        },
        "signatureAlgorithm": {
          "const": "ECDSA_P256_SHA256"
        },
        "signature": {
          "type": "string",
          "minLength": 80,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "contentEncoding": "base64"
        },
        "signatureFormat": {
          "const": "IEEE_P1363_FIXED_64",
          "type": "string"
        }
      }
    }
  }
}
