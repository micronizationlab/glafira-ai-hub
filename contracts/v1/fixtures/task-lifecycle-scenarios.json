{
  "schemaVersion": 1,
  "scenarios": [
    {
      "id": "duplicate-delivery-001",
      "title": "Duplicate delivery is idempotent",
      "task": {
        "taskId": "task-duplicate-001",
        "idempotencyKey": "idem-duplicate-001",
        "riskClass": "READ_ONLY"
      },
      "actions": [
        { "type": "ENQUEUE", "deliveryId": "delivery-first" },
        { "type": "ENQUEUE", "deliveryId": "delivery-replay" }
      ],
      "expect": {
        "acceptedTaskCount": 1,
        "executionCount": 1,
        "sameTaskIdentity": true
      }
    },
    {
      "id": "dependency-gate-001",
      "title": "Dependent task waits for prerequisite success",
      "tasks": [
        { "taskId": "task-parent-001", "dependencyTaskIds": [] },
        { "taskId": "task-child-001", "dependencyTaskIds": ["task-parent-001"] }
      ],
      "actions": [
        { "type": "ENQUEUE_ALL" },
        { "type": "CLAIM", "taskId": "task-child-001", "phase": "BEFORE_PARENT_SUCCESS" },
        { "type": "COMPLETE", "taskId": "task-parent-001", "outcome": "SUCCEEDED" },
        { "type": "CLAIM", "taskId": "task-child-001", "phase": "AFTER_PARENT_SUCCESS" }
      ],
      "expect": {
        "childClaimBeforeParentSuccess": false,
        "childClaimAfterParentSuccess": true
      }
    },
    {
      "id": "lease-fencing-001",
      "title": "Stale lease result cannot overwrite current lease",
      "taskId": "task-fenced-001",
      "leases": [
        { "leaseId": "lease-old-001", "agentId": "agent-worker-001", "fencingToken": 1 },
        { "leaseId": "lease-new-001", "agentId": "agent-worker-002", "fencingToken": 2 }
      ],
      "actions": [
        { "type": "ACCEPT_LEASE", "leaseId": "lease-new-001" },
        { "type": "SUBMIT_RESULT", "leaseId": "lease-old-001", "fencingToken": 1 }
      ],
      "expect": {
        "staleResultAccepted": false,
        "currentFencingToken": 2,
        "currentLeaseUnchanged": true
      }
    },
    {
      "id": "agent-revocation-001",
      "title": "Revoked Agent cannot claim after reconnect",
      "agentId": "agent-revoked-001",
      "request": {
        "revocationId": "revoke-agent-001",
        "enrollmentId": "enroll-revoked-001",
        "requestedByDeviceId": "owner-device-001",
        "reasonCode": "OWNER_REQUEST"
      },
      "decision": {
        "status": "REVOKED",
        "lastAcceptedFencingToken": 7,
        "activeLeaseDisposition": "OUTCOME_UNKNOWN",
        "requiresOwnerReconciliation": true
      },
      "actions": [
        { "type": "ENROLL", "decision": "APPROVED" },
        { "type": "REVOKE" },
        { "type": "RECONNECT" },
        { "type": "CLAIM" }
      ],
      "expect": {
        "agentStatus": "REVOKED",
        "claimAccepted": false
      }
    },
    {
      "id": "unknown-side-effect-001",
      "title": "Uncertain external side effect requires reconciliation",
      "task": {
        "taskId": "task-side-effect-001",
        "idempotencyKey": "idem-side-effect-001",
        "riskClass": "EXTERNAL_SIDE_EFFECT",
        "approvalRef": "approval-owner-001"
      },
      "actions": [
        { "type": "LEASE_EXPIRES_DURING_EXTERNAL_CALL" },
        { "type": "RECOVER_WORKER" }
      ],
      "expect": {
        "outcome": "OUTCOME_UNKNOWN",
        "retryable": false,
        "requiresReconciliation": true,
        "automaticReplayAllowed": false
      }
    }
  ]
}
