<Window x:Class="GLAFIRA.Desktop.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GLAFIRA Desktop Control Center" Height="900" Width="1180" MinHeight="700" MinWidth="900" Background="#F4F7F6">
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="GLAFIRA" FontSize="13" FontWeight="Bold" Foreground="#176B55"/>
          <TextBlock Text="DESKTOP CONTROL CENTER" FontSize="25" FontWeight="SemiBold" Foreground="#172B25"/>
          <TextBlock Text="Узлы, очередь задач и состояние распределённого исполнения" Foreground="#52645D" Margin="0,4,0,14"/>
        </StackPanel>
        <Button Content="Обновить" Width="110" Height="34" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Refresh_Click"/>
      </DockPanel>
      <UniformGrid Columns="3" Margin="0,0,0,12">
        <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="ОДОБРЕННЫЕ ОНЛАЙН-АГЕНТЫ" FontSize="10" Foreground="#52645D"/><TextBlock Text="{Binding OnlineAgents}" FontSize="28" FontWeight="Bold" Foreground="#176B55"/></StackPanel></Border>
        <Border Background="White" CornerRadius="8" Padding="14" Margin="4,0"><StackPanel><TextBlock Text="ЗАДАЧИ В ОЧЕРЕДИ" FontSize="10" Foreground="#52645D"/><TextBlock Text="{Binding PendingTasks}" FontSize="28" FontWeight="Bold" Foreground="#176B55"/></StackPanel></Border>
        <Border Background="White" CornerRadius="8" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="ТРЕБУЮТ ВНИМАНИЯ" FontSize="10" Foreground="#52645D"/><TextBlock Text="{Binding AttentionTasks}" FontSize="28" FontWeight="Bold" Foreground="#A34A32"/></StackPanel></Border>
      </UniformGrid>
      <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="BRIDGE HTTPS · WINDOWS DESKTOP HUB" FontSize="11" FontWeight="Bold" Foreground="#176B55"/>
            <TextBlock Text="{Binding BridgeHost.Status}" FontSize="14" FontWeight="SemiBold" Foreground="#172B25" Margin="0,4,0,2"/>
            <TextBlock Text="Сетевой адрес для подключения агентов:" FontSize="10" Foreground="#52645D" Margin="0,2,0,2"/>
            <ComboBox ItemsSource="{Binding BridgeHost.AvailableAddresses}" SelectedItem="{Binding BridgeHost.SelectedAddress, Mode=TwoWay}" MinWidth="220" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding BridgeHost.AvailableAddressesText}" FontSize="10" Foreground="#7B6551" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding BridgeHost.EndpointsText}" FontSize="11" Foreground="#52645D" TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding BridgeHost.CertificateFingerprintSha256}" FontSize="10" Foreground="#7B6551" TextWrapping="Wrap" Margin="0,3,0,0"/>
            <Separator Margin="0,12,0,9"/>
            <TextBlock Text="СОПРЯЖЕНИЕ WINDOWS AGENT" FontSize="11" FontWeight="Bold" Foreground="#176B55"/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Agent ID" VerticalAlignment="Center" Foreground="#52645D"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BridgeHost.PairingAgentId, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" MinWidth="360"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Scopes через запятую" VerticalAlignment="Center" Foreground="#52645D" Margin="0,6,0,0"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BridgeHost.PairingScopesText, UpdateSourceTrigger=PropertyChanged}" MinWidth="360" Margin="0,6,0,0"/>
            </Grid>
            <WrapPanel Margin="0,8,0,0">
              <Button Content="Создать код на 2 минуты" Height="32" Padding="10,0" Margin="0,0,8,0" Click="CreatePairingTicket_Click" IsEnabled="{Binding BridgeHost.CanCreatePairingTicket}"/>
              <Button Content="Скопировать" Height="32" Padding="10,0" Margin="0,0,8,0" Click="CopyPairingTicket_Click" IsEnabled="{Binding BridgeHost.CanCopyPairingTicket}"/>
              <Button Content="Аннулировать код" Height="32" Padding="10,0" Margin="0,0,8,0" Click="ClearPairingTicket_Click" IsEnabled="{Binding BridgeHost.CanCopyPairingTicket}"/>
              <Button Content="Отозвать Agent" Height="32" Padding="10,0" Margin="0,0,8,0" Click="RevokeAgent_Click" IsEnabled="{Binding BridgeHost.CanRevokeAgent}"/>
              <Button Content="Отозвать и создать новый код" Height="32" Padding="10,0" Click="RePairAgent_Click" IsEnabled="{Binding BridgeHost.CanRePairAgent}"/>
            </WrapPanel>
            <TextBlock Text="{Binding BridgeHost.PairingStatus}" FontSize="10" Foreground="#7B6551" TextWrapping="Wrap" Margin="0,6,0,3"/>
            <TextBox Text="{Binding BridgeHost.PairingInvitationText}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" MaxHeight="90" VerticalScrollBarVisibility="Auto"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Button Content="Обновить адреса" Height="34" Margin="0,0,8,0" Click="RefreshBridgeAddresses_Click"/>
            <Button Content="Запустить HTTPS" Height="34" Margin="0,0,8,0" Padding="12,0" Click="StartBridge_Click" IsEnabled="{Binding BridgeHost.CanStart}"/>
            <Button Content="Остановить" Height="34" Padding="12,0" Click="StopBridge_Click" IsEnabled="{Binding BridgeHost.CanStop}"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#52645D" FontSize="11" Margin="0,8,0,0"/>
    <TabControl Background="White">
      <TabItem Header="GITHUB">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="GITHUB · НЕЗАВИСИМЫЙ КАНАЛ DESKTOP" FontSize="13" FontWeight="Bold" Foreground="#176B55"/>
            <TextBlock Text="Подключение выполняется независимо от Android и Bridge. Доступ ограничен репозиторием micronizationlab/glafira-ai-hub. Изменения выполняются только в отдельной feature-ветке; слияние в main из этого интерфейса невозможно." TextWrapping="Wrap" Foreground="#52645D" Margin="0,6,0,14"/>
            <Border Background="#F4F7F6" CornerRadius="8" Padding="16">
              <StackPanel>
                <TextBlock Text="СОСТОЯНИЕ АВТОРИЗАЦИИ" FontWeight="Bold" Foreground="#176B55"/>
                <TextBlock x:Name="GitHubStatusText" Text="GitHub не подключён" FontSize="15" FontWeight="SemiBold" Foreground="#172B25" Margin="0,8,0,4"/>
                <TextBlock x:Name="GitHubAccountText" Text="Подключение не выполнялось" Foreground="#52645D" TextWrapping="Wrap"/>
                <TextBlock x:Name="GitHubDeviceCodeText" Text="" FontSize="24" FontWeight="Bold" Foreground="#176B55" Margin="0,14,0,4"/>
                <TextBlock x:Name="GitHubDeviceInstructionsText" Text="" Foreground="#52645D" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="GitHubConnectButton" Content="Подключить GitHub" Height="34" Padding="14,0" Click="GitHubConnect_Click"/>
                  <Button x:Name="GitHubCancelButton" Content="Отменить" Height="34" Padding="14,0" Margin="8,0,0,0" Click="GitHubCancel_Click" IsEnabled="False"/>
                  <Button x:Name="GitHubDisconnectButton" Content="Отключить и удалить сессию" Height="34" Padding="14,0" Margin="8,0,0,0" Click="GitHubDisconnect_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Background="#F4F7F6" CornerRadius="8" Padding="14" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО GITHUB" FontWeight="Bold" Foreground="#176B55"/>
                <TextBlock Text="Чтение main, создание feature-ветки, изменение выбранного файла и открытие Draft PR. Каждый шаг требует отдельного подтверждения владельца. Слияния и изменение настроек репозитория недоступны." TextWrapping="Wrap" Foreground="#52645D" Margin="0,4,0,8"/>
                <WrapPanel>
                  <Button x:Name="GitHubLoadTreeButton" Content="Загрузить дерево main" Height="32" Padding="12,0" Click="GitHubLoadTree_Click"/>
                  <Button x:Name="GitHubReadFileButton" Content="Прочитать выбранный файл" Height="32" Padding="12,0" Margin="8,0,0,0" Click="GitHubReadFile_Click"/>
                </WrapPanel>
                <TextBlock Text="FEATURE-ВЕТКА (НЕ MAIN)" FontWeight="Bold" Foreground="#176B55" Margin="0,12,0,5"/>
                <WrapPanel>
                  <TextBox x:Name="GitHubFeatureBranchText" Text="glafira/owner-work" Width="260" Height="30" VerticalContentAlignment="Center"/>
                  <Button x:Name="GitHubCreateBranchButton" Content="Создать ветку от main" Height="32" Padding="12,0" Margin="8,0,0,0" Click="GitHubCreateBranch_Click"/>
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                  <Button x:Name="GitHubWriteFileButton" Content="Записать выбранный файл в ветку" Height="32" Padding="12,0" Click="GitHubWriteFile_Click" IsEnabled="False"/>
                </WrapPanel>
                <TextBlock x:Name="GitHubWorkspaceStatusText" Text="Подключите GitHub, затем загрузите дерево репозитория." Foreground="#52645D" TextWrapping="Wrap" Margin="0,8,0,6"/>
                <DataGrid x:Name="GitHubTreeGrid" Height="230" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="3*"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="70"/>
                    <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="80"/>
                    <DataGridTextColumn Header="SHA" Binding="{Binding Sha}" Width="2*"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="СОДЕРЖИМОЕ ВЫБРАННОГО ФАЙЛА · РЕДАКТИРУЕТСЯ ЛОКАЛЬНО ДО НАЖАТИЯ «ЗАПИСАТЬ»" FontWeight="Bold" Foreground="#176B55" Margin="0,12,0,5"/>
                <TextBox x:Name="GitHubFileContentText" IsReadOnly="False" AcceptsReturn="True"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" Height="220" FontFamily="Consolas" FontSize="11"/>
                <TextBlock Text="DRAFT PULL REQUEST" FontWeight="Bold" Foreground="#176B55" Margin="0,12,0,5"/>
                <TextBox x:Name="GitHubPullRequestTitleText" Text="GLAFIRA: owner-reviewed changes" Height="30" VerticalContentAlignment="Center"/>
                <TextBox x:Name="GitHubPullRequestBodyText" Text="Изменения подготовлены GLAFIRA в отдельной feature-ветке. Требуются проверка CI и независимое review владельца/сопровождающего. Автоматическое слияние не выполняется." AcceptsReturn="True" TextWrapping="Wrap" Height="74" Margin="0,6,0,0"/>
                <Button x:Name="GitHubOpenDraftPullRequestButton" Content="Открыть Draft PR" Height="34" Padding="14,0" Margin="0,8,0,0" Click="GitHubOpenDraftPullRequest_Click" IsEnabled="False"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Безопасность" FontWeight="Bold" Foreground="#176B55" Margin="0,16,0,5"/>
            <TextBlock Text="Токены хранятся через Windows DPAPI CurrentUser. Client Secret и приватный ключ GitHub App не используются. Запись возможна только после отдельного подтверждения владельца, только в feature-ветку и только в разрешённые исходные/документные файлы; CI, build/dependency configuration, настройки репозитория и main защищены. Интерфейс может открыть только Draft PR; merge, обход branch protection и произвольное выполнение команд отсутствуют." TextWrapping="Wrap" Foreground="#52645D"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="АГЕНТЫ">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Bottom" Background="#F4F7F6" CornerRadius="8" Padding="12" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="ОДОБРЕНИЕ И ДОСТУПЫ ВЛАДЕЛЬЦА" FontWeight="Bold" FontSize="11" Foreground="#176B55"/>
              <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="Capabilities:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="AgentCapabilitiesInput" Width="330" Margin="0,0,12,0"/>
                <TextBlock Text="Параллельность:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="AgentParallelInput" Width="48" Text="1" Margin="0,0,12,0"/>
                <Button Content="Одобрить выбранного" Height="30" Padding="10,0" Margin="0,0,8,0" Click="ApproveSelectedAgent_Click"/>
                <Button Content="Отозвать доступ" Height="30" Padding="10,0" Click="RevokeSelectedAgent_Click"/>
              </WrapPanel>
              <TextBlock Text="Допустимые возможности: document.analysis, code.build, web.research, core.orchestration, agent.diagnostics.read. Сопряжение создаёт агента без прав; права появляются только после вашего одобрения." FontSize="10" Foreground="#52645D" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
          <DataGrid x:Name="AgentsGrid" ItemsSource="{Binding Agents}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="Agents_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Agent ID" Binding="{Binding AgentId}" Width="*"/>
              <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceId}" Width="*"/>
              <DataGridTextColumn Header="Возможности" Binding="{Binding Capabilities}" Width="2*"/>
              <DataGridTextColumn Header="Параллельность" Binding="{Binding MaxParallelTasks}" Width="110"/>
              <DataGridCheckBoxColumn Header="Одобрен" Binding="{Binding OwnerApproved}" Width="80"/>
              <DataGridCheckBoxColumn Header="Онлайн" Binding="{Binding IsOnline}" Width="70"/>
              <DataGridTextColumn Header="Последний heartbeat" Binding="{Binding LastHeartbeat, StringFormat={}{0:dd.MM HH:mm:ss}}" Width="150"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="ОЧЕРЕДЬ ЗАДАЧ">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="8">
            <WrapPanel VerticalAlignment="Center">
              <TextBlock Text="Проект:" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox Width="220" MaxLength="128" Margin="0,0,10,0"
                       Text="{Binding DiagnosticsProjectId, UpdateSourceTrigger=PropertyChanged}"/>
              <Button Content="Запустить безопасную диагностику" Height="32" Padding="12,0"
                      Click="QueueDiagnostics_Click" IsEnabled="{Binding CanQueueDiagnostics}"/>
            </WrapPanel>
            <TextBlock Text="Фиксированный локальный снимок runtime: без пользовательских команд, путей к файлам и сетевых обращений. Требует явно одобренной capability agent.diagnostics.read."
                       Foreground="#52645D" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,8"/>
            <WrapPanel VerticalAlignment="Center">
              <Button Content="Отменить выбранную задачу" Height="32" Padding="12,0"
                      Click="CancelSelectedTask_Click" IsEnabled="{Binding CanCancelSelectedTask}"/>
              <TextBlock Text="Для активной задачи с записью/внешним эффектом отмена переводит результат в OutcomeUnknown."
                         Foreground="#7B6551" FontSize="10" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </WrapPanel>
            <Separator Margin="0,8,0,6"/>
            <TextBlock Text="БЕЗОПАСНЫЙ РЕЗУЛЬТАТ ВЫБРАННОЙ ЗАДАЧИ" FontWeight="Bold" FontSize="10" Foreground="#176B55"/>
            <TextBlock Text="{Binding SelectedTaskResultSummary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0"><Run Text="Ссылка: "/><Run Text="{Binding SelectedTaskArtifactReference}"/></TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="10"><Run Text="SHA-256: "/><Run Text="{Binding SelectedTaskArtifactDigest}"/></TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="10"><Run Text="Контракт: "/><Run Text="{Binding SelectedTaskArtifactContract}"/></TextBlock>
          </StackPanel>
          <DataGrid x:Name="TasksGrid" ItemsSource="{Binding Tasks}" SelectionChanged="Tasks_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Task ID" Binding="{Binding TaskId}" Width="1.5*"/>
              <DataGridTextColumn Header="Проект" Binding="{Binding ProjectId}" Width="*"/>
              <DataGridTextColumn Header="Тип" Binding="{Binding TaskType}" Width="*"/>
              <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="120"/>
              <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="80"/>
              <DataGridTextColumn Header="Риск" Binding="{Binding EffectRisk}" Width="120"/>
              <DataGridTextColumn Header="Попытки" Binding="{Binding Attempts}" Width="75"/>
              <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM HH:mm:ss}}" Width="140"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="ИСТОРИЯ ЗАДАЧ">
        <DataGrid ItemsSource="{Binding TaskHistory}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Событие" Binding="{Binding EventId}" Width="85"/>
            <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="130"/>
            <DataGridTextColumn Header="Время" Binding="{Binding OccurredAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="165"/>
            <DataGridTextColumn Header="Агент" Binding="{Binding AgentId}" Width="*"/>
            <DataGridTextColumn Header="Код" Binding="{Binding EventCode}" Width="160"/>
            <DataGridTextColumn Header="Прогресс" Binding="{Binding ProgressPercent}" Width="90"/>
            <DataGridTextColumn Header="Сообщение" Binding="{Binding ProgressMessage}" Width="2*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
    <TextBlock DockPanel.Dock="Bottom" Text="Сопряжение, одобрение и отзыв выполняются только явным действием владельца. Разрешён только ограниченный read-only обработчик безопасной диагностики; остальные LIVE-действия выключены." Foreground="#7B6551" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </DockPanel>
</Window>
