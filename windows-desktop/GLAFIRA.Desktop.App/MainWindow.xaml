<Window x:Class="GLAFIRA.Desktop.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GLAFIRA Desktop Control Center" Height="760" Width="1180" MinHeight="600" MinWidth="900" Background="#F4F7F6">
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="GLAFIRA" FontSize="13" FontWeight="Bold" Foreground="#176B55"/>
          <TextBlock Text="DESKTOP CONTROL CENTER" FontSize="25" FontWeight="SemiBold" Foreground="#172B25"/>
          <TextBlock Text="Узлы, очередь задач и состояние распределённого исполнения" Foreground="#52645D" Margin="0,4,0,14"/>
        </StackPanel>
        <Button Content="Обновить" Width="110" Height="34" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Refresh_Click"/>
      </DockPanel>
      <UniformGrid Columns="3" Margin="0,0,0,12">
        <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="ОДОБРЕННЫЕ ОНЛАЙН-АГЕНТЫ" FontSize="10" Foreground="#52645D"/><TextBlock Text="{Binding OnlineAgents}" FontSize="28" FontWeight="Bold" Foreground="#176B55"/></StackPanel></Border>
        <Border Background="White" CornerRadius="8" Padding="14" Margin="4,0"><StackPanel><TextBlock Text="ЗАДАЧИ В ОЧЕРЕДИ" FontSize="10" Foreground="#52645D"/><TextBlock Text="{Binding PendingTasks}" FontSize="28" FontWeight="Bold" Foreground="#176B55"/></StackPanel></Border>
        <Border Background="White" CornerRadius="8" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="ТРЕБУЮТ ВНИМАНИЯ" FontSize="10" Foreground="#52645D"/><TextBlock Text="{Binding AttentionTasks}" FontSize="28" FontWeight="Bold" Foreground="#A34A32"/></StackPanel></Border>
      </UniformGrid>
      <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="BRIDGE HTTPS · WINDOWS DESKTOP HUB" FontSize="11" FontWeight="Bold" Foreground="#176B55"/>
            <TextBlock Text="{Binding BridgeHost.Status}" FontSize="14" FontWeight="SemiBold" Foreground="#172B25" Margin="0,4,0,2"/>
            <TextBlock Text="Сетевой адрес для подключения агентов:" FontSize="10" Foreground="#52645D" Margin="0,2,0,2"/>
            <ComboBox ItemsSource="{Binding BridgeHost.AvailableAddresses}" SelectedItem="{Binding BridgeHost.SelectedAddress, Mode=TwoWay}" MinWidth="220" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding BridgeHost.AvailableAddressesText}" FontSize="10" Foreground="#7B6551" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding BridgeHost.EndpointsText}" FontSize="11" Foreground="#52645D" TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding BridgeHost.CertificateFingerprintSha256}" FontSize="10" Foreground="#7B6551" TextWrapping="Wrap" Margin="0,3,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Создать билет сопряжения · 5 минут" Height="32" Padding="12,0" Click="CreatePairingTicket_Click" IsEnabled="{Binding BridgeHost.CanCreatePairingTicket}"/>
              <Button Content="Скопировать" Height="32" Margin="8,0,0,0" Padding="12,0" Click="CopyPairingTicket_Click" IsEnabled="{Binding BridgeHost.CanCopyPairingTicket}"/>
            </StackPanel>
            <TextBox Text="{Binding BridgeHost.PairingTicketDescriptor}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="92" Margin="0,8,0,0" FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Button Content="Обновить адреса" Height="34" Margin="0,0,8,0" Click="RefreshBridgeAddresses_Click"/>
            <Button Content="Запустить HTTPS" Height="34" Margin="0,0,8,0" Padding="12,0" Click="StartBridge_Click" IsEnabled="{Binding BridgeHost.CanStart}"/>
            <Button Content="Остановить" Height="34" Padding="12,0" Click="StopBridge_Click" IsEnabled="{Binding BridgeHost.CanStop}"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#52645D" FontSize="11" Margin="0,8,0,0"/>
    <TabControl Background="White">
      <TabItem Header="GITHUB">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="GITHUB · НЕЗАВИСИМЫЙ КАНАЛ DESKTOP" FontSize="13" FontWeight="Bold" Foreground="#176B55"/>
            <TextBlock Text="Подключение выполняется отдельно от Android и Bridge. Доступ ограничен репозиторием micronizationlab/glafira-ai-hub; текущий этап — только чтение." TextWrapping="Wrap" Foreground="#52645D" Margin="0,6,0,14"/>
            <Border Background="#F4F7F6" CornerRadius="8" Padding="16">
              <StackPanel>
                <TextBlock Text="СОСТОЯНИЕ АВТОРИЗАЦИИ" FontWeight="Bold" Foreground="#176B55"/>
                <TextBlock x:Name="GitHubStatusText" Text="GitHub не подключён" FontSize="15" FontWeight="SemiBold" Foreground="#172B25" Margin="0,8,0,4"/>
                <TextBlock x:Name="GitHubAccountText" Text="Подключение не выполнялось" Foreground="#52645D" TextWrapping="Wrap"/>
                <TextBlock x:Name="GitHubDeviceCodeText" Text="" FontSize="24" FontWeight="Bold" Foreground="#176B55" Margin="0,14,0,4"/>
                <TextBlock x:Name="GitHubDeviceInstructionsText" Text="" Foreground="#52645D" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="GitHubConnectButton" Content="Подключить GitHub" Height="34" Padding="14,0" Click="GitHubConnect_Click"/>
                  <Button x:Name="GitHubCancelButton" Content="Отменить" Height="34" Padding="14,0" Margin="8,0,0,0" Click="GitHubCancel_Click" IsEnabled="False"/>
                  <Button x:Name="GitHubDisconnectButton" Content="Отключить и удалить сессию" Height="34" Padding="14,0" Margin="8,0,0,0" Click="GitHubDisconnect_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="Безопасность" FontWeight="Bold" Foreground="#176B55" Margin="0,16,0,5"/>
            <TextBlock Text="Токены хранятся через Windows DPAPI CurrentUser. Client Secret и приватный ключ GitHub App не используются. Подключение и проверка запускаются только по вашему нажатию; произвольные команды оболочки, запись в репозиторий и слияние изменений этим экраном не выполняются. Отдельная блокировка владельца и разрешение на операции остаются обязательным следующим этапом." TextWrapping="Wrap" Foreground="#52645D"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="АГЕНТЫ">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Bottom" Background="#F4F7F6" CornerRadius="8" Padding="12" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="ОДОБРЕНИЕ И ДОСТУПЫ ВЛАДЕЛЬЦА" FontWeight="Bold" FontSize="11" Foreground="#176B55"/>
              <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="Capabilities:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="AgentCapabilitiesInput" Width="330" Margin="0,0,12,0"/>
                <TextBlock Text="Параллельность:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="AgentParallelInput" Width="48" Text="1" Margin="0,0,12,0"/>
                <Button Content="Одобрить выбранного" Height="30" Padding="10,0" Margin="0,0,8,0" Click="ApproveSelectedAgent_Click"/>
                <Button Content="Отозвать доступ" Height="30" Padding="10,0" Click="RevokeSelectedAgent_Click"/>
              </WrapPanel>
              <TextBlock Text="Допустимые возможности: document.analysis, code.build, web.research, core.orchestration. Сопряжение создаёт агента без прав; права появляются только после вашего одобрения." FontSize="10" Foreground="#52645D" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
          <DataGrid x:Name="AgentsGrid" ItemsSource="{Binding Agents}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Agent ID" Binding="{Binding AgentId}" Width="*"/>
              <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceId}" Width="*"/>
              <DataGridTextColumn Header="Возможности" Binding="{Binding Capabilities}" Width="2*"/>
              <DataGridTextColumn Header="Параллельность" Binding="{Binding MaxParallelTasks}" Width="110"/>
              <DataGridCheckBoxColumn Header="Одобрен" Binding="{Binding OwnerApproved}" Width="80"/>
              <DataGridCheckBoxColumn Header="Онлайн" Binding="{Binding IsOnline}" Width="70"/>
              <DataGridTextColumn Header="Последний heartbeat" Binding="{Binding LastHeartbeat, StringFormat={}{0:dd.MM HH:mm:ss}}" Width="150"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="ОЧЕРЕДЬ ЗАДАЧ">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
            <Button Content="Отменить выбранную задачу" Height="32" Padding="12,0"
                    Click="CancelSelectedTask_Click" IsEnabled="{Binding CanCancelSelectedTask}"/>
            <TextBlock Text="Для активной задачи с записью/внешним эффектом отмена переводит результат в OutcomeUnknown."
                       Foreground="#7B6551" FontSize="10" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <DataGrid x:Name="TasksGrid" ItemsSource="{Binding Tasks}" SelectionChanged="Tasks_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Task ID" Binding="{Binding TaskId}" Width="1.5*"/>
              <DataGridTextColumn Header="Проект" Binding="{Binding ProjectId}" Width="*"/>
              <DataGridTextColumn Header="Тип" Binding="{Binding TaskType}" Width="*"/>
              <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="120"/>
              <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="80"/>
              <DataGridTextColumn Header="Риск" Binding="{Binding EffectRisk}" Width="120"/>
              <DataGridTextColumn Header="Попытки" Binding="{Binding Attempts}" Width="75"/>
              <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM HH:mm:ss}}" Width="140"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="ИСТОРИЯ ЗАДАЧ">
        <DataGrid ItemsSource="{Binding TaskHistory}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Событие" Binding="{Binding EventId}" Width="85"/>
            <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="130"/>
            <DataGridTextColumn Header="Время" Binding="{Binding OccurredAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="165"/>
            <DataGridTextColumn Header="Агент" Binding="{Binding AgentId}" Width="*"/>
            <DataGridTextColumn Header="Код" Binding="{Binding EventCode}" Width="160"/>
            <DataGridTextColumn Header="Прогресс" Binding="{Binding ProgressPercent}" Width="90"/>
            <DataGridTextColumn Header="Сообщение" Binding="{Binding ProgressMessage}" Width="2*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
    <TextBlock DockPanel.Dock="Bottom" Text="Pairing, heartbeat и защищённый Agent lease/result transport доступны. Production handlers и Desktop Core task handoff ещё подключаются; LIVE-действия остаются выключены." Foreground="#7B6551" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </DockPanel>
</Window>